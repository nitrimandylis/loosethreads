# --- Required ---
DATABASE_URL=                      # Neon Postgres connection string
#                                  # locally, pglite:.pgdata runs Postgres in-process,
#                                  # no server, data in a gitignored folder
ADMIN_SECRET=                      # password for /admin (min 8 chars; use something long)

# That is everything. The per-IP rate limit counts in the database above, so
# there is nothing else to configure and no way to deploy with the limit off:
# if Postgres is reachable it is enforced, and if it is not, nothing works.
#
# There is no bot check. Nothing is reviewed before it publishes either, so the
# rate limit and the takedown console at /admin are the whole story.
