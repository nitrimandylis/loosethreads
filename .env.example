# --- Required ---
DATABASE_URL=                      # Neon Postgres connection string
#                                  # locally, pglite:.pgdata runs Postgres in-process,
#                                  # no server, data in a gitignored folder
ADMIN_SECRET=                      # password for /admin (min 8 chars; use something long)

# --- Required in production, optional locally ---
# Nothing is moderated before it publishes, so these four are the whole gate.
# In production the submit route fails closed: with any of them missing, every
# submission is refused with a 503. Locally they are skipped entirely.
UPSTASH_REDIS_REST_URL=            # per-IP rate limit
UPSTASH_REDIS_REST_TOKEN=
TURNSTILE_SECRET_KEY=              # Cloudflare Turnstile bot check
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
